# Copie este arquivo para .env e ajuste os valores.
# NUNCA faça commit do arquivo .env preenchido.

# --- Núcleo ------------------------------------------------------------------
# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave

# True apenas em desenvolvimento local. Em produção use False.
DEBUG=True

# Domínios que podem servir a aplicação (separados por vírgula).
ALLOWED_HOSTS=127.0.0.1,localhost

# Necessário em produção atrás de HTTPS (ex.: https://crm-atletica.onrender.com)
CSRF_TRUSTED_ORIGINS=

# --- Banco de dados --------------------------------------------------------
# Deixe em branco para usar SQLite local (dev).
# Em produção, cole a "Connection string" do Supabase (Session/Transaction pooler):
#   postgres://USUARIO:SENHA@HOST:5432/postgres
DATABASE_URL=

# --- E-mail (recuperação de senha em produção) ----------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=CRM Atletica <usuario@gmail.com>

# --- Integração Google Sheets (fase 2 — opcional) ------------------------
# Caminho do JSON da service account do Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# ID da planilha (o trecho entre /d/ e /edit na URL do Google Sheets).
GOOGLE_SHEETS_SPREADSHEET_ID=
